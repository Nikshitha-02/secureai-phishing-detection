# ─────────────────────────────────────────────
#  SecureAI – Backend Environment Variables
#  Copy this file to .env and fill in values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────

# Node environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# ── Supabase ──────────────────────────────────
# Project URL (found in Supabase → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — has full DB access, NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Gemini AI ─────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use for AI explanations.
# Change this value to switch models without touching source code.
# See available models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash
